# Copy to /etc/default/chainmind and edit.
# Read by chainmind-agent.service on every run.

# What the agent is asked to do each time the timer fires.
CHAINMIND_GOAL="review today's telemetry and note anything worth acting on"

# Which key in /var/lib/chainmind/keys/ signs the work.
CHAINMIND_AGENT=atlas

# Ceiling on the CPU limit handed to any single sandboxed tool, in
# milliseconds. Keep this small on a machine that runs something
# latency-sensitive: it is the worst case one action can occupy.
CHAINMIND_COMPUTE_MS=2000
