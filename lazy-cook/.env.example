# --- Database ---
DATABASE_URL="postgresql://lazy:lazy@localhost:5432/lazycook?schema=public"

# --- Auth.js ---
# generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""
AUTH_SECRET=""
# Only needed behind a proxy that hides the real host; trustHost uses the request host otherwise.
# NEXTAUTH_URL="https://your-domain.example"
AUTH_TRUST_HOST="true"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# SMTP connection string for one-time codes, e.g. smtp://user:pass@smtp.example.com:587
# Leave empty in development: the code is printed to the server console instead.
EMAIL_SERVER=""
EMAIL_FROM="آشپز تنبل <no-reply@example.com>"

# --- AI (server-side only; used from phase 3) ---
ANTHROPIC_API_KEY=""
AI_MODEL_PLANNER="claude-sonnet-5-5"
AI_MODEL_FAST="claude-haiku-5-5"
AI_DAILY_LIMIT_FREE="20"
AI_DAILY_LIMIT_PRO="200"

# --- Storage (photos; phase 3+) ---
STORAGE_BUCKET=""
STORAGE_URL=""
STORAGE_KEY=""

# --- Payments (phase 4) ---
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_MONTHLY=""
STRIPE_PRICE_YEARLY=""

# --- Web Push (phase 4) ---
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@example.com"

# --- Monitoring / analytics (phase 4) ---
SENTRY_DSN=""
POSTHOG_KEY=""
